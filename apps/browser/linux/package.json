{
  "name": "@ardia/browser-linux",
  "version": "0.0.0",
  "private": true,
  "description": "Ardia on Linux: the Electron host for the shared UI",
  "main": "out/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:ui": "vite build --config renderer/vite.config.ts",
    "build": "pnpm build:ui && pnpm build:main",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@ardia/ardiacore": "workspace:*",
    "@ardia/core": "workspace:*",
    "@ardia/expo-linux": "workspace:*",
    "@ardia/import": "workspace:*",
    "@ardia/shaders": "workspace:*",
    "@ardia/shell": "workspace:*",
    "@ardia/sync": "workspace:*",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native-web": "^0.21.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "45.3.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.9"
  }
}
