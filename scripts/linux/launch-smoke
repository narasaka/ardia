#!/usr/bin/env bash
# Usage: scripts/linux/launch-smoke <out-dir> [--app PATH] [--port N] [--display N] [--timeout seconds]
# Starts a hidden instance with a fresh data dir (scripts/linux/test-instance), opens scripts/linux/fixtures/smoke.html as a
# launch link, waits for the first app window and for the page to load, screenshots every window and page into <out-dir>
# (scripts/linux/capture), quits it through the quit handshake and checks the session was saved. Exits 1 on any miss.
# Uses $DISPLAY's server when --display isn't given and DISPLAY is set (as under xvfb-run).
set -euo pipefail
[[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]] && { sed -n "2,6p" "$0" | cut -c3-; exit 0; }
repo="$(cd "$(dirname "$0")/../.." && pwd)"
out="$1"; shift
app=(); port=9390; display=""; timeout=90
while [[ $# -gt 0 ]]; do
  case "$1" in
    --app) app=(--app "$2"); shift 2 ;;
    --port) port="$2"; shift 2 ;;
    --display) display="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    *) echo "launch-smoke: unknown option $1" >&2; exit 2 ;;
  esac
done
[[ -z "$display" && -n "${DISPLAY:-}" ]] && display="${DISPLAY#:}" && display="${display%%.*}"
[[ -z "$display" ]] && display=190
mkdir -p "$out"
export ARDIA_INSTANCES="$out/instances"
name=smoke
data="$out/data"
rm -rf "$data" "$ARDIA_INSTANCES"
page="file://$repo/scripts/linux/fixtures/smoke.html"

fail() { echo "launch-smoke: $*" >&2; cp "$ARDIA_INSTANCES/$name/instance.log" "$out/instance.log" 2>/dev/null || true; "$repo/scripts/linux/test-instance" "$name" --stop >/dev/null 2>&1 || true; exit 1; }

started=$(date +%s)
pid="$("$repo/scripts/linux/test-instance" "$name" --port "$port" --display "$display" --data "$data" "${app[@]}" -- "$page")" || fail "the instance didn't start"
echo "launch-smoke: instance $pid answers on port $port after $(( $(date +%s) - started )) s"

targets() { curl -fs "http://127.0.0.1:$port/json/list" || echo "[]"; }
deadline=$(( started + timeout ))
window=""; loaded=""
while (( $(date +%s) < deadline )); do
  kill -0 "$pid" 2>/dev/null || fail "Ardia exited"
  list="$(targets)"
  [[ -z "$window" ]] && window="$(jq -r '[.[] | select(.type == "page" and .url == "about:blank" and .title != "")] | first | .title // empty' <<< "$list")"
  [[ -z "$loaded" ]] && loaded="$(jq -r --arg page "$page" '[.[] | select(.url == $page and .title == "Ardia smoke page")] | first | .type // empty' <<< "$list")"
  [[ -n "$window" && -n "$loaded" ]] && break
  sleep 0.5
done
[[ -n "$window" ]] || fail "no app window opened in $timeout s"
[[ -n "$loaded" ]] || fail "the smoke page didn't load in $timeout s"
echo "launch-smoke: window \"$window\" and the smoke page ($loaded) after $(( $(date +%s) - started )) s"
sleep 2
"$repo/scripts/linux/capture" "$port" "$out/screenshots" || fail "no screenshot"
if command -v xprop >/dev/null && command -v xwininfo >/dev/null; then
  classes="$(for id in $(DISPLAY=":$display" xwininfo -root -children | grep -o '^ *0x[0-9a-f]*'); do DISPLAY=":$display" xprop -id "$id" WM_CLASS 2>/dev/null; done | grep -o '"[^"]*", "[^"]*"' | sort -u | tr '\n' ' ')"
  echo "launch-smoke: window classes $classes"
  [[ "$classes" == *'"ardia", "ardia"'* ]] || fail "no window has the class ardia, which ardia.desktop's StartupWMClass names"
fi
"$repo/scripts/linux/test-instance" "$name" --stop
grep -q "quit quitting" "$data/launch.log" || fail "the quit handshake didn't finish"
[[ -s "$data/session.json" ]] || fail "the session wasn't saved"
cp "$ARDIA_INSTANCES/$name/instance.log" "$out/instance.log"
echo "launch-smoke: passed in $(( $(date +%s) - started )) s"
