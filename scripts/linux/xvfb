#!/usr/bin/env bash
# Usage: scripts/linux/xvfb <display-number> -- <command...>
# Runs <command> with DISPLAY=:<display-number> on a private Xvfb (1600x1000x24), started if needed and stopped after.
# Uses the system Xvfb, or the one unpacked in ~/.local/xvfb (apt-get download xvfb, dpkg-deb -x).
set -euo pipefail
[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { sed -n "2,4p" "$0" | cut -c3-; exit 0; }
display="${1:?display number}"; shift
[[ "${1:-}" == "--" ]] && shift
local_root="$HOME/.local/xvfb/root"
if command -v Xvfb >/dev/null; then xvfb=(Xvfb); xkb=()
else
  export LD_LIBRARY_PATH="$local_root/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  xvfb=("$local_root/usr/bin/Xvfb"); xkb=(-xkbdir "$local_root/usr/share/X11/xkb")
fi
started=""
if [[ ! -S "/tmp/.X11-unix/X$display" ]]; then
  "${xvfb[@]}" ":$display" -screen 0 1600x1000x24 -nolisten tcp "${xkb[@]}" >/dev/null 2>&1 &
  started=$!
  for _ in $(seq 50); do [[ -S "/tmp/.X11-unix/X$display" ]] && break; sleep 0.1; done
fi
cleanup() { [[ -n "$started" ]] && kill "$started" 2>/dev/null || true; }
trap cleanup EXIT
DISPLAY=":$display" "$@"
